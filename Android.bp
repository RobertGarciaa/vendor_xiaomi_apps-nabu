// SPDX-License-Identifier: Apache-2.0
//
// Prebuilt stock apps for the Xiaomi Pad 5 (nabu) on PixelOS Android 17.
//
// The APKs are written by tools/build-*.py from the pinned stock inputs in
// proprietary/ (Git-ignored) and signed with the ROM platform key. Soong
// re-signs them again with the same key during the ROM build, so the shipped
// artifact matches the rest of the platform.

soong_namespace {
}

// Xiaomi Notes. Privileged because the stock manifest needs
// WRITE_SECURE_SETTINGS, STATUS_BAR and MANAGE_USERS-style permissions.
//
// The stock manifest declares optional <uses-library> entries; list them all in
// manifest order. Soong splits out the ones with no module here (com.miui.system
// and the four .touch.so entries) and passes them to the checker as missing, so
// the build system stays coherent with the APK without claiming a library the
// ROM cannot provide.
android_app_import {
    name: "MIUINotes",
    product_specific: true,
    owner: "xiaomi/apps-nabu",
    apk: "proprietary/ported/product/priv-app/MIUINotes/MIUINotes.apk",
    certificate: "platform",
    privileged: true,
    optional_uses_libs: [
        "org.apache.http.legacy",
        "com.miui.system",
        "com.android.extensions.appfunctions",
        "androidx.window.extensions",
        "androidx.window.sidecar",
        "libtflite_interface_wrap.touch.so",
        "libestimate_interface.touch.so",
        "libbrushstroke_interface.touch.so",
        "librecognize_interface.touch.so",
    ],
    dex_preopt: {
        enabled: false,
    },
}

// Xiaomi Creation ("Mi Canvas"). Signature permissions use the platform certificate.
