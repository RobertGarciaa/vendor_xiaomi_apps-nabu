<?xml version="1.0" encoding="utf-8"?>
<!--
  Privileged permissions requested by com.miui.notes (MIUINotes 3.2.7.4).

  Only permissions the manifest actually declares are listed. Every entry is a
  signature|privileged permission that a priv-app must be granted explicitly on
  Android 17; omitting one makes the package manager silently deny it.
-->
<permissions>
    <privapp-permissions package="com.miui.notes">
        <permission name="android.permission.ACCESS_KEYGUARD_SECURE_STORAGE" />
        <permission name="android.permission.INTERACT_ACROSS_USERS" />
        <permission name="android.permission.INTERNAL_SYSTEM_WINDOW" />
        <permission name="android.permission.MANAGE_EXTERNAL_STORAGE" />
        <permission name="android.permission.MANAGE_USERS" />
        <permission name="android.permission.READ_CLIPBOARD_IN_BACKGROUND" />
        <permission name="android.permission.READ_FRAME_BUFFER" />
        <permission name="android.permission.READ_SECURE_SETTINGS" />
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
        <permission name="android.permission.STATUS_BAR" />
        <permission name="android.permission.SUPPRESS_CLIPBOARD_ACCESS_NOTIFICATION" />
        <permission name="android.permission.SYSTEM_OVERLAY_WINDOW" />
        <permission name="android.permission.UNLIMITED_TOASTS" />
        <permission name="android.permission.WRITE_MEDIA_STORAGE" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>
</permissions>
